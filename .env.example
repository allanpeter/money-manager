# O valor real fica em ../infra/ansible/secrets.enc.env, protegido pelo SOPS.
PG_MONEY_MANAGER_PASSWORD=<senha-do-SOPS>
PG_MONEY_MANAGER_DEV_PASSWORD=<senha-dev-do-SOPS>

# Desenvolvimento usa uma base isolada. Gere .env.local com `npm run env:dev`.
# Produção recebe DATABASE_URL exclusivamente pelas variáveis do Coolify.
DATABASE_URL=postgres://money_manager_dev:<senha-dev-do-SOPS>@192.168.0.41:5432/money_manager_dev

# PostgreSQL interno da LAN; habilite TLS se o servidor passar a exigi-lo.
DATABASE_SSL=false

AUTH_COOKIE_SECURE=false

# Assistente. Mantenha os valores reais no SOPS, nunca neste arquivo.
OPENAI_API_KEY=<chave-da-openai>
OPENAI_MODEL=gpt-5.4-mini
DISCORD_BOT_TOKEN=<token-do-bot>
DISCORD_ALLOWED_USER_IDS=<seu-user-id-do-discord>
DISCORD_CHANNEL_ID=<canal-privado-de-comandos>
DISCORD_REMINDER_CHANNEL_ID=<canal-de-lembretes>
TELEGRAM_BOT_TOKEN=<token-do-botfather>
TELEGRAM_ALLOWED_USER_IDS=<user-id-opcional-para-bootstrap>
REMINDER_POLL_INTERVAL_MS=900000
# Use somente em desenvolvimento para testar a conexão dos bots sem enviar lembretes.
ASSISTANT_DISABLE_REMINDERS=false

# Diretório local onde `npm run db:backup` grava os dumps.
BACKUP_DIR=./backups
